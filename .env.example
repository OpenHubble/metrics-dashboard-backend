# Frontend
FRONTEND_URL=http://localhost:3000

# Application
APP_MODE=development

# Database Application
POSTGRESQL_APP_URL="postgresql+psycopg2://user:password@host:port/metrics"

# Database Andromeda
TIMESCALEDB_ANDROMEDA_URL="postgresql+psycopg2://user:password@host:port/andromeda"

# Security
SECRET=replace-with-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256

# Sentry
SENTRY_DSN=

# Resend
RESEND_APIKEY=

# Email
EMAIL_ENDPOINT=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Firebase
FIREBASE_CREDENTIALS=
